# ==============================================================================
# Contract & SOW Risk Analyzer — Environment Configuration
# Duplicate this file to .env and adjust values for your local environment.
# ==============================================================================

# Application environment (development, staging, production)
APP_ENV=development

# When true, mock routes are active and MySQL is not required
MOCK_MODE=true

# MySQL Database configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=cra_user
DB_PASSWORD=cra_password
DB_NAME=contract_risk_analyzer

# JWT Authentication
JWT_SECRET=super-secret-development-key-change-in-production-min32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# File Upload Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# LLM Engine Configuration (called strictly via ai_engine/llm.py)
LLM_PROVIDER=stub
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=stub-dummy-key-not-for-production

# Vector Search & Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_DIR=chroma_data

# OCR Engine (Pratyush / doc_engine) - leave empty if tesseract is in PATH
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

